# Flask App Configuration
SECRET_KEY=your_secret_key_here

# Environment Setting: True for local database, False for production database
LOCAL_SERVER=True

# Database Connection URIs
LOCAL_URI=mysql://username:password@localhost/database_name
PROD_URI=mysql+mysqldb://username:password@hostname/database_name

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=True
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_email_app_password
MAIL_REPLY_TO=your_reply_email@gmail.com

# Blog & Pagination Settings
NO_OF_POSTS=3

# Admin Dashboard Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=your_admin_password

# Site Social Links
FB_URL=https://www.facebook.com/
TW_URL=https://www.twitter.com/
GTHB_URL=https://www.github.com/

# Site Branding & Information
BLOG_NAME="Coding Thunder"
TAG_LINE="Heaven for Programmers"
ABOUT_TEXT="Welcome to my blog! Your custom about text goes here."
